# Server-only Firebase configuration. Never prefix admin credentials with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=beyonn-website-cms
FIREBASE_WEB_API_KEY=your_firebase_web_app_api_key
FIREBASE_STORAGE_BUCKET=beyonn-cms-media-347549647510
# Local development only. Use Application Default Credentials on Google-hosted production.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/private/credentials.json
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Set to your exact public origin if your reverse proxy rewrites the request origin.
# CMS_ALLOWED_ORIGIN=https://your-backend.hosted.app

# Vercel / non-Google servers only: encrypted server-only service-account JSON.
# FIREBASE_ADMIN_CREDENTIALS=
